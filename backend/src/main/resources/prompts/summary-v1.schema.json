{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Trace summary (prompt sum-1, spec section 11.4)",
  "type": "object",
  "additionalProperties": false,
  "required": ["headline", "status", "whatHappened", "whereItFailed", "anomalyExplanations", "likelyCause", "suggestedChecks", "uncertainty"],
  "properties": {
    "headline": {"type": "string", "minLength": 1, "maxLength": 140},
    "status": {"type": "string", "enum": ["COMPLETED", "FAILED", "REJECTED", "INCOMPLETE"]},
    "whatHappened": {
      "type": "array", "maxItems": 20,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["stage", "text", "evidenceIds"],
        "properties": {
          "stage": {"type": "string", "minLength": 1, "maxLength": 64},
          "text": {"type": "string", "minLength": 1, "maxLength": 600},
          "evidenceIds": {"$ref": "#/$defs/evidenceIds"}
        }
      }
    },
    "whereItFailed": {
      "type": ["object", "null"], "additionalProperties": false, "required": ["stage", "component", "text", "evidenceIds"],
      "properties": {
        "stage": {"type": "string", "minLength": 1, "maxLength": 64},
        "component": {"type": "string", "minLength": 1, "maxLength": 200},
        "text": {"type": "string", "minLength": 1, "maxLength": 600},
        "evidenceIds": {"$ref": "#/$defs/evidenceIds"}
      }
    },
    "anomalyExplanations": {
      "type": "array", "maxItems": 20,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["ruleId", "text", "evidenceIds"],
        "properties": {
          "ruleId": {"type": "string", "pattern": "^R[0-9]{2}$"},
          "text": {"type": "string", "minLength": 1, "maxLength": 600},
          "evidenceIds": {"$ref": "#/$defs/evidenceIds"}
        }
      }
    },
    "likelyCause": {
      "type": ["object", "null"], "additionalProperties": false, "required": ["text", "confidence", "evidenceIds"],
      "properties": {
        "text": {"type": "string", "minLength": 1, "maxLength": 600},
        "confidence": {"type": "string", "enum": ["LOW", "MEDIUM", "HIGH"]},
        "evidenceIds": {"$ref": "#/$defs/evidenceIds"}
      }
    },
    "suggestedChecks": {"type": "array", "maxItems": 10, "items": {"type": "string", "minLength": 1, "maxLength": 300}},
    "uncertainty": {"type": "string", "maxLength": 600}
  },
  "$defs": {
    "evidenceIds": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"type": "string", "pattern": "^ev[0-9]{1,3}$"}}
  }
}
