# Copy to deploy/.env and fill in. Never commit the real file.
# `make up` copies this file to deploy/.env on first run if it does not exist.
# Every value here is a placeholder for local development (spec section 14.2).

# --- Postgres (existing) ---
DB_NAME=ielop
DB_USERNAME=ielop
DB_PASSWORD=change-me
DB_PORT=5433

# --- Backend auth (existing) ---
# Required outside the dev profile: 32+ random bytes, base64.
JWT_SECRET=change-me-to-a-long-random-string-at-least-64-chars
JWT_EXPIRATION_MS=3600000
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Elastic stack (one pinned patch for every Elastic image) ---
ELASTIC_VERSION=9.5.2
# Superuser; only the setup container uses it.
ELASTIC_PASSWORD=change-me
KIBANA_SYSTEM_PASSWORD=change-me
LOGSTASH_WRITER_PASSWORD=change-me
ES_URL=http://elasticsearch:9200
ES_USERNAME=backend_reader
ES_PASSWORD=change-me
# Keyed hash for counterparty accounts (Logstash fingerprint filter).
COUNTERPARTY_HASH_KEY=change-me
# Point at existing ECS indices if you have them.
ES_INDEX_PATTERN=logs-flow-*
FLOW_DEFINITIONS_DIR=config/flows
# Zone of format D lines (demo value; default UTC).
LOG_TIMEZONE=Asia/Kolkata

# --- Memory (optional) ---
# Defaults are the spec's values (section 14.1). Lower them on a Docker VM with less than 8 GB,
# for example ES_HEAP=768m, LS_HEAP=384m on a 4 GB VM.
# ES_HEAP=1g
# ES_MEM_LIMIT=2g
# LS_HEAP=512m
# LS_MEM_LIMIT=1g
# BACKEND_HEAP=512m
# FRONTEND_MEM_LIMIT=512m

# --- AI ---
AI_ENABLED=true
# fake or openai
AI_PROVIDER=fake
# OpenAI-compatible endpoint (owner's choice: Google AI Studio, free tier)
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# Never committed.
AI_API_KEY=
# Set by the owner: gemini-3.8-flash for demos, gemini-3.5-flash-lite while developing.
AI_MODEL=gemini-3.8-flash
AI_MAX_CONTEXT_TOKENS=12000
AI_MAX_OUTPUT_TOKENS=1500
AI_TIMEOUT_SECONDS=60
# Ordered fallbacks, tried when the provider before is busy or failing (one retry each on 429/503/timeout).
# A provider with an empty key is skipped.
AI_FALLBACK1_BASE_URL=https://api.groq.com/openai/v1
AI_FALLBACK1_API_KEY=
AI_FALLBACK1_MODEL=openai/gpt-oss-120b
AI_FALLBACK1_MAX_CONTEXT_TOKENS=5000
AI_FALLBACK2_BASE_URL=https://integrate.api.nvidia.com/v1
AI_FALLBACK2_API_KEY=
AI_FALLBACK2_MODEL=openai/gpt-oss-120b
AI_FALLBACK2_MAX_CONTEXT_TOKENS=12000

# --- Generator ---
GEN_SEED=42
# First simulated day, local to LOG_TIMEZONE. make demo sets it so the data ends yesterday.
GEN_START=2026-05-15T08:00
# 10000 for make demo
GEN_FLOWS=1000
# 7 for make demo
GEN_DAYS=1
# Phase 3: write OpenTelemetry trace IDs into every format (spec section 15)
GEN_OTEL=false
